<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        tools:context=".DisplayDetailsActivity">

        <!-- Top Header Card -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card_bg"
            android:padding="16dp">

            <ImageView
                android:id="@+id/ivDisplayIcon"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:src="@drawable/ic_check"
                android:contentDescription="Success Badge" />

            <TextView
                android:id="@+id/tvDisplayTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toEndOf="@id/ivDisplayIcon"
                android:layout_marginStart="12dp"
                android:text="@string/title_display_details"
                android:textColor="@color/primary"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDisplaySubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/tvDisplayTitle"
                android:layout_toEndOf="@id/ivDisplayIcon"
                android:layout_marginStart="12dp"
                android:layout_marginTop="2dp"
                android:text="@string/subtitle_display_details"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="#DCFCE7"
                android:paddingStart="8dp"
                android:paddingTop="4dp"
                android:paddingEnd="8dp"
                android:paddingBottom="4dp"
                android:text="Activity 2"
                android:textColor="#166534"
                android:textSize="11sp"
                android:textStyle="bold" />
        </RelativeLayout>

        <!-- Card containing the TableLayout for Submitted Details -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/card_bg"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/table_header_title"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="12dp"
                android:text="Displayed in non-editable TextViews styled via TableLayout"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <!-- TableLayout implementation -->
            <TableLayout
                android:id="@+id/tableStudentDetails"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:shrinkColumns="0"
                android:stretchColumns="1">

                <!-- Table Header Row -->
                <TableRow
                    android:background="@drawable/table_header_bg"
                    android:padding="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.4"
                        android:text="@string/col_field"
                        android:textColor="@color/table_header_text"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.6"
                        android:text="@string/col_value"
                        android:textColor="@color/table_header_text"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </TableRow>

                <!-- Row 1: Registration ID -->
                <TableRow
                    android:background="@drawable/table_cell_bg"
                    android:padding="10dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.4"
                        android:text="@string/row_reg_id"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvDisplayRegId"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.6"
                        android:text="STU-2026-0001"
                        android:textColor="@color/primary"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </TableRow>

                <!-- Row 2: Full Name -->
                <TableRow
                    android:background="@drawable/table_cell_alt_bg"
                    android:padding="10dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.4"
                        android:text="@string/row_name"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvDisplayName"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.6"
                        android:text="John Doe"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </TableRow>

                <!-- Row 3: Email Address -->
                <TableRow
                    android:background="@drawable/table_cell_bg"
                    android:padding="10dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.4"
                        android:text="@string/row_email"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvDisplayEmail"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.6"
                        android:text="john.doe@university.edu"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp" />
                </TableRow>

                <!-- Row 4: Gender -->
                <TableRow
                    android:background="@drawable/table_cell_alt_bg"
                    android:padding="10dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.4"
                        android:text="@string/row_gender"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvDisplayGender"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.6"
                        android:text="Male"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp" />
                </TableRow>

                <!-- Row 5: Date of Birth -->
                <TableRow
                    android:background="@drawable/table_cell_bg"
                    android:padding="10dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.4"
                        android:text="@string/row_dob"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvDisplayDob"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.6"
                        android:text="15/08/2001"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp" />
                </TableRow>

                <!-- Row 6: Course Selected -->
                <TableRow
                    android:background="@drawable/table_cell_alt_bg"
                    android:padding="10dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.4"
                        android:text="@string/row_course"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvDisplayCourse"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.6"
                        android:text="MCA"
                        android:textColor="@color/primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </TableRow>

                <!-- Row 7: Terms Accepted -->
                <TableRow
                    android:background="@drawable/table_cell_bg"
                    android:padding="10dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.4"
                        android:text="@string/row_terms"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvDisplayTerms"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.6"
                        android:text="Yes (Agreed)"
                        android:textColor="@color/success"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </TableRow>

                <!-- Row 8: Timestamp -->
                <TableRow
                    android:background="@drawable/table_cell_alt_bg"
                    android:padding="10dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.4"
                        android:text="@string/row_timestamp"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvDisplayTimestamp"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.6"
                        android:text="2026-09-29 08:30:00"
                        android:textColor="@color/text_muted"
                        android:textSize="12sp"
                        android:fontFamily="monospace" />
                </TableRow>
            </TableLayout>
        </LinearLayout>

        <!-- Enrolled Courses Card: ListView and Spinner as required in (d) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/card_bg"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/section_enrolled_courses"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvCoursesSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/subtitle_enrolled_courses"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <!-- Filter Spinner for Enrolled Courses -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/label_filter_spinner"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/input_field_bg"
                android:paddingStart="8dp"
                android:paddingEnd="8dp">

                <Spinner
                    android:id="@+id/spinnerCourseFilter"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:spinnerMode="dropdown" />
            </RelativeLayout>

            <!-- ListView for Enrolled Courses (Container layout that will hold courses) -->
            <LinearLayout
                android:id="@+id/coursesContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="vertical" />

            <!-- Also include real ListView for explicit ListView testing -->
            <ListView
                android:id="@+id/listViewEnrolledCourses"
                android:layout_width="match_parent"
                android:layout_height="320dp"
                android:divider="@android:color/transparent"
                android:dividerHeight="8dp"
                android:visibility="gone" />

            <!-- Interactive selected course notification view -->
            <TextView
                android:id="@+id/tvSelectedCourseDetail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="#EFF6FF"
                android:padding="10dp"
                android:text="Tap any course above to view syllabus highlights &amp; faculty info."
                android:textColor="@color/primary"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Navigation Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnBack"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:text="@string/btn_back_to_registration"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btnNewRegistration"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:backgroundTint="@color/primary"
                android:text="New Student"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Lifecycle & State Monitor Card for Activity 2 -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="24dp"
            android:background="@drawable/card_bg"
            android:padding="16dp">

            <TextView
                android:id="@+id/tvLifecycleTitle2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentTop="true"
                android:layout_alignParentStart="true"
                android:text="Activity 2 Lifecycle Monitor"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:text="TAG: StudentLoginDemo_Act2"
                android:textColor="@color/text_muted"
                android:textSize="10sp"
                android:fontFamily="monospace" />

            <TextView
                android:id="@+id/tvLifecycleStatus2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/tvLifecycleTitle2"
                android:layout_marginTop="6dp"
                android:background="#F1F5F9"
                android:padding="8dp"
                android:text="Current State: Initializing...\nExplicit Intent extras parsed successfully."
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:fontFamily="monospace" />
        </RelativeLayout>

    </LinearLayout>
</ScrollView>
